#!/bin/sh
set -eu

# The purpose account has a deliberately minimal login environment. Select the
# reviewed host tools explicitly instead of depending on an interactive PATH.
PATH=/usr/local/bin:/usr/bin:/bin
export PATH

# Install this root-owned executable as the login shell for soda-release-ci.
# It accepts only the phases below; all work paths come from the run identity.
config=/etc/soda-release-ci.conf
[ -r "$config" ] || { echo 'release executor configuration is unavailable' >&2; exit 1; }
# The configuration is root-controlled and must set only these values.
. "$config"
: "${SODA_RELEASE_ROOT:?SODA_RELEASE_ROOT is required}"
: "${SODA_RELEASE_REPOSITORY:?SODA_RELEASE_REPOSITORY is required}"

die() { echo "soda-release-executor: $*" >&2; exit 1; }

is_decimal() { printf '%s' "$1" | grep -Eq '^[0-9]+$'; }
is_sha() { printf '%s' "$1" | grep -Eq '^[0-9a-f]{40}$'; }
is_architecture() { [ "$1" = x86_64 ] || [ "$1" = aarch64 ]; }

require_run_identity() {
    [ "$#" -eq 4 ] || die 'phase requires run ID, attempt, source revision, and architecture'
    is_decimal "$1" || die 'run ID must be decimal'
    is_decimal "$2" || die 'attempt must be decimal'
    is_sha "$3" || die 'source revision must be a full lowercase Git SHA'
    is_architecture "$4" || die 'architecture must be x86_64 or aarch64'
}

run_directory() { printf '%s/runs/%s-%s-%s-%s\n' "$SODA_RELEASE_ROOT" "$1" "$2" "$3" "$4"; }
worktree() { printf '%s/source\n' "$1"; }

read_secret_line() {
    variable=$1
    IFS= read -r value || die "missing $variable on standard input"
    [ -n "$value" ] || die "$variable is empty"
    case "$value" in *'\n'*|*'\r'*) die "$variable contains a line break" ;; esac
    printf '%s' "$value"
}

release_version() { awk -F '"' '$1 ~ /^version[[:space:]]*=/ { print $2; exit }' "$1/distro/soda.toml"; }

artifact_paths() {
    source_tree=$1
    architecture=$2
    version=$(release_version "$source_tree")
    [ -n "$version" ] || die 'source checkout has no Soda version'
    archive=$source_tree/.artifacts/images/soda-os-$version-$architecture.oci.tar
    iso=$source_tree/.artifacts/images/SodaOS-$version-$architecture.iso
    qcow2=$source_tree/.artifacts/images/SodaOS-$version-$architecture.qcow2
    compressed=$qcow2.zst
    record=$source_tree/.artifacts/releases/soda-os-$version-$architecture.release.json
}

build_environment() {
    run=$1
    temp=$(mktemp -d "$(dirname "$SODA_RELEASE_ROOT")/t.XXXXXX")
    ln -s "$temp" "$run/tmp"
    install -d -m 0700 "$run/go-cache"
    export RUNNER_TEMP=$temp TMPDIR=$temp GOCACHE=$run/go-cache
}

checkout_source() {
    destination=$1
    revision=$2
    [ ! -e "$destination" ] || die 'derived source directory already exists'
    git clone --no-checkout "$SODA_RELEASE_REPOSITORY" "$destination"
    git -C "$destination" checkout --detach "$revision"
    test -z "$(git -C "$destination" status --porcelain=v1 --untracked-files=no)" || die 'fresh source checkout is not clean'
}

login_ghcr() {
    token=$1
    auth_file=$2
    printf '%s' "$token" | skopeo login --authfile "$auth_file" --username x-access-token --password-stdin ghcr.io >/dev/null
}

build_and_stage() {
    source_tree=$1
    run=$2
    revision=$3
    architecture=$4
    github_token=$5
    artifact_paths "$source_tree" "$architecture"
    build_environment "$run"
    (
        cd "$source_tree"
        just check
        just rpm "$architecture"
        just oci "$architecture"
    )
    auth_file=$run/registry-auth-$architecture.json
    (
        trap 'rm -f "$auth_file"' 0 1 2 15
        umask 077
        login_ghcr "$github_token" "$auth_file"
        cd "$source_tree"
        REGISTRY_AUTH_FILE=$auth_file go run ./cmd/soda-release image-stage --architecture "$architecture" --archive "$archive"
        just iso "$architecture" "$archive"
        just qcow2 "$architecture" "$archive"
        just record "$architecture" "$archive" "$iso" "$qcow2" "$compressed"
    )
    test -f "$record" || die 'native release record was not created'
    test "$(jq -r .source_revision "$record")" = "$revision" || die 'release record source revision differs from requested revision'
}

prepare() {
    require_run_identity "$@"
    run=$(run_directory "$@")
    [ ! -e "$run" ] || die 'derived release run directory already exists'
    github_token=$(read_secret_line github_token)
    umask 077
    install -d -m 0700 "$run"
    source_tree=$(worktree "$run")
    checkout_source "$source_tree" "$3"
    build_and_stage "$source_tree" "$run" "$3" "$4" "$github_token"
    unset github_token
}

emit_record() {
    require_run_identity "$@"
    run=$(run_directory "$@")
    source_tree=$(worktree "$run")
    artifact_paths "$source_tree" "$4"
    cat "$record"
}

emit_bundle() {
    require_run_identity "$@"
    run=$(run_directory "$@")
    source_tree=$(worktree "$run")
    artifact_paths "$source_tree" "$4"
    bundle=$record.sigstore.json
    [ -f "$bundle" ] || die 'signed release-record bundle is unavailable'
    cat "$bundle"
}

promote() {
    require_run_identity "$@"
    run=$(run_directory "$@")
    source_tree=$(worktree "$run")
    [ -d "$source_tree/.git" ] || die 'prepared source checkout is unavailable'
    github_token=$(read_secret_line github_token)
    sigstore_token=$(read_secret_line sigstore_oidc_token)
    artifact_paths "$source_tree" "$4"
    (
        auth_file=$run/registry-promote-$4.json
        trap 'rm -f "$auth_file"' 0 1 2 15
        umask 077
        login_ghcr "$github_token" "$auth_file"
        cd "$source_tree"
        GH_TOKEN=$github_token REGISTRY_AUTH_FILE=$auth_file SIGSTORE_ID_TOKEN=$sigstore_token \
            go run ./cmd/soda-release image-promote --architecture "$4" --record "$record"
        GH_TOKEN=$github_token SIGSTORE_ID_TOKEN=$sigstore_token \
            go run ./cmd/soda-release record-sign --architecture "$4" --record "$record"
    )
    unset github_token sigstore_token
}

upload() {
    require_run_identity "$@"
    run=$(run_directory "$@")
    source_tree=$(worktree "$run")
    [ -d "$source_tree/.git" ] || die 'prepared source checkout is unavailable'
    github_token=$(read_secret_line github_token)
    artifact_paths "$source_tree" "$4"
    [ -f "$record.sigstore.json" ] || die 'signed release-record bundle is unavailable'
    (
        cd "$source_tree"
        GH_TOKEN=$github_token \
            go run ./cmd/soda-release upload --architecture "$4" --iso "$iso" --qcow2-zst "$compressed" --record "$record" --record-bundle "$record.sigstore.json"
    )
    unset github_token
}

if [ "${1:-}" = -c ]; then
    [ "$#" -eq 2 ] || die 'SSH invocation must contain one fixed command string'
    command_line=$2
    case "$command_line" in
        *[!A-Za-z0-9_\ -]*) die 'SSH command contains unsupported characters' ;;
    esac
    old_ifs=$IFS
    IFS=' '
    # Word splitting is intentional after the strict character allowlist.
    # shellcheck disable=SC2086
    set -- $command_line
    IFS=$old_ifs
    [ "${1:-}" = soda-release-executor ] || die 'SSH command must invoke soda-release-executor'
    shift
fi

phase=${1:-}
shift || true
case "$phase" in
    prepare) prepare "$@" ;;
    emit-record) emit_record "$@" ;;
    emit-bundle) emit_bundle "$@" ;;
    promote) promote "$@" ;;
    upload) upload "$@" ;;
    *) die 'supported phases are prepare, emit-record, emit-bundle, promote, and upload' ;;
esac
