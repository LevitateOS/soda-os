root = true

[*.{html,ejs,css,js,ts,mjs,mts}]
indent_style = space
indent_size = 2

[*.{json,yaml,yml,toml,proto}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[*.sh]
indent_style = tab
indent_size = tab
tab_width = 4

[*.swift]
indent_style = space
indent_size = 4

[{Containerfile,Dockerfile}]
indent_style = space
indent_size = 4

[{justfile,Justfile}]
indent_style = space
indent_size = 4

[{Makefile,Makefile.*,*.mk}]
indent_style = tab
indent_size = tab

[*.md]
indent_style = space
