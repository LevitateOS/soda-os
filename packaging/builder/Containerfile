FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install \
      ca-certificates \
      cpio \
      gcc \
      gcc-c++ \
      git \
      golang \
      make \
      pam-devel \
      pkgconf-pkg-config \
      rpm-build \
      systemd-rpm-macros \
      tar \
      unzip \
      xz \
    && dnf clean all

WORKDIR /src
