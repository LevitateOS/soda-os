#!/bin/sh
set -eu

usage() {
  echo "usage: soda-local-access CONNECTION [on|off]" >&2
  exit 2
}

[ "$(id -u)" -eq 0 ] || {
  echo "soda-local-access must run as root" >&2
  exit 1
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
connection=$1
mode=${2:-status}

case "$mode" in
  status)
    if [ "$(nmcli -g connection.zone connection show "$connection")" = trusted ]; then
      echo on
    else
      echo off
    fi
    ;;
  on)
    nmcli connection modify "$connection" connection.zone trusted
    nmcli connection up "$connection"
    ;;
  off)
    nmcli connection modify "$connection" connection.zone drop
    nmcli connection up "$connection"
    ;;
  *) usage ;;
esac
