#!/usr/bin/python3

import fcntl
import http.client
import json
import os
import pwd
import grp
import re
import stat
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path


INPUT_DIR = Path("/var/lib/soda-install/cloud")
TAILSCALE_DIR = Path("/var/lib/soda-install")
TAILSCALE_KEY = TAILSCALE_DIR / "tailscale-auth-key"
FORGEJO_CONFIG = Path("/etc/forgejo/app.ini")
SHADOW_PATH = Path("/etc/shadow")
USERNAME_PATTERN = re.compile(r"[a-z][a-z0-9-]{0,23}")


def _open_input(name, maximum):
    path = INPUT_DIR / name
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise RuntimeError(f"required cloud input {name} is unavailable") from None
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o077 or metadata.st_size == 0 or metadata.st_size > maximum:
        os.close(descriptor)
        raise RuntimeError(f"required cloud input {name} is invalid")
    try:
        path.unlink()
    except OSError:
        os.close(descriptor)
        raise RuntimeError(f"required cloud input {name} could not be removed") from None
    return descriptor


def _read_input(descriptor, name):
    try:
        with os.fdopen(descriptor, "rb") as stream:
            value = stream.read().rstrip(b"\r\n")
    except OSError:
        raise RuntimeError(f"required cloud input {name} could not be read") from None
    if not value or b"\x00" in value or b"\r" in value or b"\n" in value:
        raise RuntimeError(f"required cloud input {name} is invalid")
    return value.decode("utf-8")


def _read_inputs():
    try:
        metadata = INPUT_DIR.lstat()
    except OSError:
        raise RuntimeError("cloud provisioning input is unavailable") from None
    if not stat.S_ISDIR(metadata.st_mode) or INPUT_DIR.is_symlink() or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o077:
        raise RuntimeError("cloud provisioning input is invalid")
    descriptors = {
        "username": _open_input("administrator-username", 128),
        "password": _open_input("administrator-password", 4096),
        "ssh_key": _open_input("administrator-authorized-key", 16384),
        "tailscale_key": _open_input("tailscale-auth-key", 4096),
    }
    values = {name: _read_input(descriptor, name) for name, descriptor in descriptors.items()}
    try:
        INPUT_DIR.rmdir()
    except OSError:
        raise RuntimeError("cloud provisioning input state could not be removed") from None
    if USERNAME_PATTERN.fullmatch(values["username"]) is None:
        raise RuntimeError("cloud administrator username is invalid")
    if len(values["ssh_key"].split()) != 2:
        raise RuntimeError("cloud administrator SSH key is invalid")
    return values


def _password_hash(username):
    try:
        descriptor = os.open(SHADOW_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise RuntimeError("cloud administrator password state is unavailable") from None
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0:
            raise RuntimeError("cloud administrator password state is invalid")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            for line in stream:
                fields = line.rstrip("\n").split(":")
                if len(fields) >= 2 and fields[0] == username:
                    return fields[1]
    except OSError:
        raise RuntimeError("cloud administrator password state is unavailable") from None
    raise RuntimeError("cloud administrator password state is unavailable")


def _validate_linux_account(username, ssh_key):
    try:
        account = pwd.getpwnam(username)
        wheel = grp.getgrnam("wheel")
    except KeyError:
        raise RuntimeError("cloud administrator account is unavailable") from None
    if account.pw_dir != f"/home/{username}" or account.pw_shell != "/bin/bash" or username not in wheel.gr_mem:
        raise RuntimeError("cloud administrator account is invalid")
    password_hash = _password_hash(username)
    if not password_hash or password_hash.startswith(("!", "*")):
        raise RuntimeError("cloud administrator password is not usable")
    key_path = Path(account.pw_dir) / ".ssh/authorized_keys"
    try:
        keys = {" ".join(line.split()[:2]) for line in key_path.read_text(encoding="utf-8").splitlines() if len(line.split()) >= 2}
    except OSError:
        raise RuntimeError("cloud administrator SSH key is unavailable") from None
    if ssh_key not in keys:
        raise RuntimeError("cloud administrator SSH key is invalid")


def _run_as(user, command, *, input_value=None, output=False):
    environment = ["/usr/bin/env", "HOME=/var/lib/forgejo" if user == "git" else f"HOME=/home/{user}", "USER=" + user, "PATH=/usr/bin:/bin"]
    completed = subprocess.run(
        ["/usr/sbin/runuser", "--user", user, "--", *environment, *command],
        input=input_value,
        stdin=subprocess.DEVNULL if input_value is None else None,
        stdout=subprocess.PIPE if output else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return completed


def _forgejo_users(admin_only=False):
    command = ["/usr/bin/forgejo", "admin", "user", "list", "--config", str(FORGEJO_CONFIG)]
    if admin_only:
        command.append("--admin")
    completed = _run_as("git", command, output=True)
    if completed.returncode != 0:
        raise RuntimeError("Forgejo user verification failed")
    users = []
    for line in completed.stdout.splitlines():
        fields = line.split()
        if fields and fields[0].isdigit():
            users.append(fields[1])
    return users


def _bootstrap_config(contents):
    required = (b"HTTP_ADDR = 127.0.0.1", b"HTTP_PORT = 30000", b"DISABLE_REGISTRATION = true", b"INSTALL_LOCK = true")
    if any(contents.count(setting) != 1 for setting in required):
        raise RuntimeError("Forgejo bootstrap configuration is invalid")
    return contents.replace(b"DISABLE_REGISTRATION = true", b"DISABLE_REGISTRATION = false", 1)


def _sealed_config(contents):
    descriptor = os.memfd_create("soda-forgejo-bootstrap", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
    try:
        with os.fdopen(os.dup(descriptor), "wb") as stream:
            stream.write(contents)
            stream.flush()
        fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, fcntl.F_SEAL_SEAL | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_WRITE)
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def _wait_for_forgejo(process):
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Forgejo exited during cloud administrator creation")
        connection = http.client.HTTPConnection("127.0.0.1", 30000, timeout=1)
        try:
            connection.request("GET", "/api/healthz")
            response = connection.getresponse()
            response.read()
            if response.status == 200:
                return
        except OSError:
            pass
        finally:
            connection.close()
        time.sleep(0.2)
    raise RuntimeError("Forgejo did not become ready")


def _signup(username, password):
    body = urllib.parse.urlencode({"user_name": username, "email": f"{username}@localhost", "password": password, "retype": password}).encode("utf-8")
    connection = http.client.HTTPConnection("127.0.0.1", 30000, timeout=10)
    try:
        connection.request("POST", "/user/sign_up", body=body, headers={"Content-Type": "application/x-www-form-urlencoded", "Content-Length": str(len(body)), "Sec-Fetch-Site": "same-origin"})
        response = connection.getresponse()
        status, location = response.status, response.getheader("Location", "")
        response.read()
    except OSError:
        raise RuntimeError("Forgejo rejected cloud administrator creation") from None
    finally:
        connection.close()
    if status != 303 or location != "/":
        raise RuntimeError("Forgejo rejected cloud administrator creation")


def _configure_tea(username, password):
    login = _run_as(username, ["/usr/bin/tea", "logins", "add", "--name", "soda", "--url", "http://127.0.0.1:30000", "--user", username, "--password-stdin", "--token-name", "soda-os-tea", "--scopes", "read:user,write:repository,write:issue"], input_value=password)
    if login.returncode != 0:
        raise RuntimeError("Tea could not create the cloud administrator login")
    identity = _run_as(username, ["/usr/bin/tea", "api", "--login", "soda", "user"], output=True)
    try:
        name = json.loads(identity.stdout)["login"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        name = ""
    if identity.returncode != 0 or name != username:
        raise RuntimeError("Tea did not verify the cloud administrator identity")
    try:
        account = pwd.getpwnam(username)
        metadata = Path(account.pw_dir, ".config/tea/config.yml").lstat()
    except OSError:
        raise RuntimeError("Tea cloud administrator configuration is unavailable") from None
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != account.pw_uid or stat.S_IMODE(metadata.st_mode) != 0o600:
        raise RuntimeError("Tea cloud administrator configuration is invalid")


def _bootstrap_forgejo(username, password):
    subprocess.run(["/usr/bin/systemctl", "stop", "forgejo.service"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    initialized = subprocess.run(["/usr/bin/systemctl", "start", "forgejo-init.service"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if initialized.returncode != 0 or _forgejo_users():
        raise RuntimeError("Forgejo bootstrap state is unavailable")
    durable = FORGEJO_CONFIG.read_bytes()
    descriptor = _sealed_config(_bootstrap_config(durable))
    process = None
    try:
        process = subprocess.Popen(["/usr/sbin/runuser", "--user", "git", "--", "/usr/bin/env", "HOME=/var/lib/forgejo", "USER=git", "FORGEJO_WORK_DIR=/var/lib/forgejo", "/usr/bin/forgejo", "web", "--config", f"/proc/self/fd/{descriptor}"], pass_fds=(descriptor,), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
        _wait_for_forgejo(process)
        _signup(username, password)
        if FORGEJO_CONFIG.read_bytes() != durable or _forgejo_users(admin_only=True) != [username]:
            raise RuntimeError("Forgejo did not create the cloud site administrator")
        _configure_tea(username, password)
    finally:
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)
        os.close(descriptor)


def _write_tailscale_key(value):
    TAILSCALE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    metadata = TAILSCALE_DIR.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or TAILSCALE_DIR.is_symlink() or metadata.st_uid != 0:
        raise RuntimeError("Tailscale enrollment handoff is invalid")
    os.chmod(TAILSCALE_DIR, 0o700)
    temporary = TAILSCALE_DIR / ".tailscale-auth-key.tmp"
    if TAILSCALE_KEY.exists() or temporary.exists():
        raise RuntimeError("Tailscale enrollment handoff already exists")
    with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600), "w", encoding="utf-8") as stream:
        stream.write(value + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, TAILSCALE_KEY)


def _enroll_tailscale():
    for action in ("enable", "start"):
        result = subprocess.run(["/usr/bin/systemctl", action, "soda-tailscale-enroll.service"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if result.returncode != 0:
            TAILSCALE_KEY.unlink(missing_ok=True)
            raise RuntimeError("Tailscale enrollment service could not be started")


def _run():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise RuntimeError("soda-cloud-finalize accepts no arguments and must run as root")
    values = _read_inputs()
    try:
        _validate_linux_account(values["username"], values["ssh_key"])
        _bootstrap_forgejo(values["username"], values["password"])
        _write_tailscale_key(values["tailscale_key"])
        _enroll_tailscale()
        subprocess.run(["/usr/bin/systemctl", "restart", "forgejo.service"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    finally:
        values["password"] = ""
        values["tailscale_key"] = ""


def main():
    try:
        _run()
    except Exception as error:
        print(f"soda-cloud-finalize: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
