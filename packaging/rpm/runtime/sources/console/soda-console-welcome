#!/bin/sh
set -eu

hostname=$(hostname -s)
[ -n "$hostname" ] || exit 0

printf '\nWelcome to Soda OS.\n\nOpen the Soda OS dashboard:\n  https://%s.local:9090\n' "$hostname"

address=$(ip -o -4 addr show scope global 2>/dev/null | awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }')
if [ -n "$address" ]; then
	printf '  https://%s:9090\n' "$address"
fi
