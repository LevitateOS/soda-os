[Unit]
Description=Soda OS persistent state directories
Documentation=man:tmpfiles.d(5) man:systemd-tmpfiles(8)
DefaultDependencies=no
RequiresMountsFor=/var
After=systemd-sysusers.service systemd-remount-fs.service
Before=local-fs.target opt-soda-toolchains.mount

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-tmpfiles --create --prefix=/var/lib/soda
RemainAfterExit=yes
