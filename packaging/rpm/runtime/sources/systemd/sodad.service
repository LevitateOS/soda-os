[Unit]
Description=Soda OS runtime daemon
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=soda-api
ExecStart=/usr/libexec/soda/sodad
Restart=on-failure
RuntimeDirectory=soda
RuntimeDirectoryMode=0770
StandardOutput=append:/var/log/soda/sodad/service.log
StandardError=append:/var/log/soda/sodad/service.log
UMask=0007

[Install]
WantedBy=multi-user.target
