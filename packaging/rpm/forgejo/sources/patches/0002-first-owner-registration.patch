new file mode 100644
--- /dev/null
+++ b/models/user/owner_setup_test.go
@@ -0,0 +1,105 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package user_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+
+	"forgejo.org/models/db"
+	"forgejo.org/models/unittest"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/services/auth/source/pam"
+	"github.com/stretchr/testify/require"
+)
+
+func emptyOwnerDatabase(t *testing.T) {
+	t.Helper()
+	require.NoError(t, unittest.InitFixtures(unittest.FixturesOptions{}))
+	t.Cleanup(func() {
+		require.NoError(t, unittest.InitFixtures(unittest.FixturesOptions{Dir: unittest.FixturesDir()}))
+	})
+	require.NoError(t, unittest.PrepareTestDatabase())
+}
+
+func TestSodaOwnerRegistration(t *testing.T) {
+	emptyOwnerDatabase(t)
+	state, err := user_model.OwnerSetup(db.DefaultContext)
+	require.NoError(t, err)
+	require.Equal(t, "register", state)
+	_, err = (&pam.Source{}).Authenticate(db.DefaultContext, nil, "linux-owner", "not-used")
+	require.ErrorIs(t, err, user_model.ErrOwnerSetupRequired)
+	require.Zero(t, user_model.CountUsers(db.DefaultContext, nil))
+	first := &user_model.User{Name: "soda-first", Email: "soda-first@example.test"}
+	require.NoError(t, user_model.CreateRegisteredUser(db.DefaultContext, first, nil))
+	require.True(t, first.IsAdmin)
+	require.True(t, first.IsActive)
+	state, err = user_model.OwnerSetup(db.DefaultContext)
+	require.NoError(t, err)
+	require.Empty(t, state)
+	second := &user_model.User{Name: "soda-second", Email: "soda-second@example.test"}
+	require.NoError(t, user_model.CreateRegisteredUser(db.DefaultContext, second, nil))
+	require.False(t, second.IsAdmin)
+	_, err = db.GetEngine(db.DefaultContext).ID(first.ID).Cols("is_active", "prohibit_login").Update(&user_model.User{IsActive: false, ProhibitLogin: true})
+	require.NoError(t, err)
+	state, err = user_model.OwnerSetup(db.DefaultContext)
+	require.NoError(t, err)
+	require.Empty(t, state, "a disabled administrator does not make the instance unclaimed")
+}
+
+func TestSodaOwnerRegistrationRollback(t *testing.T) {
+	emptyOwnerDatabase(t)
+	failure := errors.New("fail before commit")
+	err := db.WithTx(db.DefaultContext, func(ctx context.Context) error {
+		require.NoError(t, user_model.CreateRegisteredUser(ctx, &user_model.User{Name: "soda-retry", Email: "soda-retry@example.test"}, nil))
+		return failure
+	})
+	require.ErrorIs(t, err, failure)
+	state, err := user_model.OwnerSetup(db.DefaultContext)
+	require.NoError(t, err)
+	require.Equal(t, "register", state)
+	retry := &user_model.User{Name: "soda-retry", Email: "soda-retry@example.test"}
+	require.NoError(t, user_model.CreateRegisteredUser(db.DefaultContext, retry, nil))
+	require.True(t, retry.IsAdmin)
+}
+
+func TestSodaOwnerMissingAdministrator(t *testing.T) {
+	emptyOwnerDatabase(t)
+	require.NoError(t, user_model.CreateUser(db.DefaultContext, &user_model.User{Name: "soda-stranded", Email: "soda-stranded@example.test"}))
+	state, err := user_model.OwnerSetup(db.DefaultContext)
+	require.NoError(t, err)
+	require.Equal(t, "missing-admin", state)
+	require.ErrorIs(t, user_model.CreateRegisteredUser(db.DefaultContext, &user_model.User{Name: "soda-not-repair", Email: "soda-not-repair@example.test"}, nil), user_model.ErrOwnerSetupRequired)
+	require.EqualValues(t, 1, user_model.CountUsers(db.DefaultContext, nil))
+}
+
+func TestSodaOwnerConcurrentRegistration(t *testing.T) {
+	emptyOwnerDatabase(t)
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	for i := range 2 {
+		wg.Go(func() {
+			<-start
+			results <- user_model.CreateRegisteredUser(db.DefaultContext, &user_model.User{Name: fmt.Sprintf("soda-race-%d", i), Email: fmt.Sprintf("soda-race-%d@example.test", i)}, nil)
+		})
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	successes := 0
+	for err := range results {
+		if err == nil {
+			successes++
+		}
+	}
+	require.Positive(t, successes)
+	count, err := db.GetEngine(db.DefaultContext).Where("is_admin = ?", true).Count(new(user_model.User))
+	require.NoError(t, err)
+	require.EqualValues(t, 1, count)
+	require.EqualValues(t, successes, user_model.CountUsers(db.DefaultContext, nil), "failed writers must not leave partial accounts")
+}
