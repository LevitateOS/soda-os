+++ b/models/user/owner_setup.go
@@ -0,0 +1,57 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package user
+
+import (
+	"context"
+	"errors"
+
+	"forgejo.org/models/db"
+	"forgejo.org/modules/optional"
+)
+
+// ErrOwnerSetupRequired never means that a PAM account should be promoted.
+var ErrOwnerSetupRequired = errors.New("Forgejo has no administrator; complete first-owner registration before creating Linux/PAM accounts")
+
+// OwnerSetup reads native account state. No completion flag is stored or cached.
+// A remaining (even disabled) administrator means the instance is already owned.
+func OwnerSetup(ctx context.Context) (string, error) {
+	// One statement also keeps presentation consistent while registration commits.
+	var counts struct{ Users, Admins int64 }
+	_, err := db.GetEngine(ctx).Table(new(User)).
+		Where("type IN (?, ?)", UserTypeIndividual, UserTypeRemoteUser).
+		Select("COUNT(*) AS users, COALESCE(MAX(CASE WHEN is_admin THEN 1 ELSE 0 END), 0) AS admins").Get(&counts)
+	if err != nil || counts.Admins > 0 {
+		return "", err
+	}
+	if counts.Users > 0 {
+		return "missing-admin", nil
+	}
+	return "register", nil
+}
+
+// CreateRegisteredUser assigns the native first-registration role in the same
+// transaction as account creation. On Soda's SQLite database, a competing writer
+// either observes the committed owner or fails without leaving a partial account.
+func CreateRegisteredUser(ctx context.Context, u *User, overwrite *CreateUserOverwriteOptions) error {
+	return db.WithTx(ctx, func(ctx context.Context) error {
+		state, err := OwnerSetup(ctx)
+		if err != nil {
+			return err
+		}
+		if state == "missing-admin" {
+			return ErrOwnerSetupRequired
+		}
+		if state == "register" {
+			u.IsAdmin = true
+			options := CreateUserOverwriteOptions{}
+			if overwrite != nil {
+				options = *overwrite
+			}
+			options.IsActive = optional.Some(true)
+			overwrite = &options
+		}
+		return CreateUser(ctx, u, overwrite)
+	})
+}
