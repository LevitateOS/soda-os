diff --git a/services/context/owner_setup.go b/services/context/owner_setup.go
new file mode 100644
--- /dev/null
+++ b/services/context/owner_setup.go
@@ -0,0 +1,21 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package context
+
+import (
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/setting"
+)
+
+// LoadOwnerSetup supplies the home and authentication templates only.
+func (ctx *Context) LoadOwnerSetup() bool {
+	state, err := user_model.OwnerSetup(ctx)
+	if err != nil {
+		ctx.ServerError("OwnerSetup", err)
+		return false
+	}
+	ctx.Data["SodaOwnerSetup"] = state
+	ctx.Data["SodaOwnerRegistrationAllowed"] = !setting.Service.DisableRegistration && !setting.Service.AllowOnlyExternalRegistration
+	return true
+}
