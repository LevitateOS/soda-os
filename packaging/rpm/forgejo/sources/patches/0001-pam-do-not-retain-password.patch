@@ -0,0 +1,24 @@
+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package pam
+
+import (
+	"testing"
+
+	"forgejo.org/models/auth"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestNewPAMUserDoesNotCopyExternalPasswordVerifier(t *testing.T) {
+	user := newPAMUser("Alice", "alice@example.test", "alice", 42)
+
+	assert.Equal(t, "Alice", user.Name)
+	assert.Equal(t, "alice", user.LowerName)
+	assert.Equal(t, auth.PAM, user.LoginType)
+	assert.Equal(t, int64(42), user.LoginSource)
+	assert.Equal(t, "alice", user.LoginName)
+	assert.Empty(t, user.Passwd)
+	assert.Empty(t, user.Salt)
+	assert.Empty(t, user.PasswdHashAlgo)
+}
