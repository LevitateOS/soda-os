#!/bin/sh
set -eu

template=/usr/share/soda/forgejo/app.ini.tmpl
target=/etc/forgejo/app.ini

mode=""
case "$#" in
  0) ;;
  1) mode=$1 ;;
  *) echo "usage: forgejo-init [refresh-tailnet]" >&2; exit 2 ;;
esac
case "$mode" in
  ""|refresh-tailnet) ;;
  *) echo "usage: forgejo-init [refresh-tailnet]" >&2; exit 2 ;;
esac

identity=$(hostnamectl --static)
address=0.0.0.0
port=30000
root_url=http://${identity}:${port}/

# Forgejo listens on the trusted LAN and Tailscale interfaces.
if endpoint=$(/usr/libexec/soda/forgejo-tailnet 2>/dev/null); then
  set -- $endpoint
  identity=$1
  root_url=http://${identity}:${port}/
elif [ "$mode" = refresh-tailnet ]; then
  echo "Tailscale enrollment is not available to Forgejo" >&2
  exit 1
fi

if [ "$mode" = refresh-tailnet ]; then
  if awk -v identity="$identity" -v url="$root_url" '
    /^[[:space:]]*\[/ { server = ($0 ~ /^[[:space:]]*\[server\][[:space:]]*$/) }
    server && /^[[:space:]]*(DOMAIN|SSH_DOMAIN|ROOT_URL)[[:space:]]*=/ {
      key=$0; sub(/[[:space:]]*=.*/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); sub(/[[:space:]]+$/, "", value)
      if (key == "ROOT_URL") { root++; if (value != url) wrong=1 }
      else if (key == "DOMAIN") { domain++; if (value != identity) wrong=1 }
      else { ssh++; if (value != identity) wrong=1 }
    }
    END { exit !(root == 1 && domain == 1 && ssh == 1 && !wrong) }
  ' "$target"; then
    exit 0
  fi
  # Requires/After reruns the inactive oneshot initializer before Forgejo starts.
  exec systemctl restart forgejo.service
fi

install -d -m 0750 -o root -g git /etc/forgejo
if [ ! -e "$target" ]; then
  umask 077
  internal_token=$(forgejo generate secret INTERNAL_TOKEN)
  jwt_secret=$(forgejo generate secret JWT_SECRET)
  lfs_jwt_secret=$(forgejo generate secret LFS_JWT_SECRET)
  secret_key=$(forgejo generate secret SECRET_KEY)
  sed \
    -e "s/@INTERNAL_TOKEN@/${internal_token}/g" \
    -e "s/@JWT_SECRET@/${jwt_secret}/g" \
    -e "s/@LFS_JWT_SECRET@/${lfs_jwt_secret}/g" \
    -e "s/@SECRET_KEY@/${secret_key}/g" \
    "$template" > "$target.tmp"
  chown root:git "$target.tmp"
  chmod 0640 "$target.tmp"
  mv "$target.tmp" "$target"
fi


sed \
  -e "s|^HTTP_ADDR = .*|HTTP_ADDR = ${address}|" \
  -e "s|^HTTP_PORT = .*|HTTP_PORT = ${port}|" \
  -e "s|^DOMAIN = .*|DOMAIN = ${identity}|" \
  -e "s|^SSH_DOMAIN = .*|SSH_DOMAIN = ${identity}|" \
  -e "s|^ROOT_URL = .*|ROOT_URL = ${root_url}|" \
  "$target" > "$target.tmp"
chown root:git "$target.tmp"
chmod 0640 "$target.tmp"
mv "$target.tmp" "$target"

runuser --user git -- forgejo migrate --config "$target"
if ! runuser --user git -- forgejo admin auth list --config "$target" | grep -F 'Soda OS' >/dev/null; then
  runuser --user git -- forgejo admin auth add-pam --config "$target" \
    --name 'Soda OS' --service-name soda-forgejo --active
fi
