@@ -212,0 +208,19 @@ func generateToken(ctx stdctx.Context, login config.Login, user, pass, otp, scop
+func selectAccessTokenName(tokens []*gitea.AccessToken, requested, host string, now time.Time) (string, error) {
+	if requested != "" {
+		for _, token := range tokens {
+			if token.Name == requested {
+				return "", fmt.Errorf("access token name %q already exists", requested)
+			}
+		}
+		return requested, nil
+	}
+
+	name := host + "-tea"
+	for _, token := range tokens {
+		if token.Name == name {
+			return name + now.Format("2006-01-02_15-04-05"), nil
+		}
+	}
+	return name, nil
+}
