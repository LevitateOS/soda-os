+
+	gitea "gitea.dev/sdk"
+)
@@ -57,0 +63,21 @@ func TestShouldCheckTokenUniqueness(t *testing.T) {
+
+func TestSelectAccessTokenName(t *testing.T) {
+	tokens := []*gitea.AccessToken{{Name: "soda-os-tea"}, {Name: "host-tea"}}
+	if _, err := selectAccessTokenName(tokens, "soda-os-tea", "host", time.Unix(0, 0)); err == nil {
+		t.Fatal("expected an exact requested token-name collision")
+	}
+	name, err := selectAccessTokenName(tokens, "other", "host", time.Unix(0, 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "other" {
+		t.Fatalf("expected requested token name, got %q", name)
+	}
+	name, err = selectAccessTokenName(tokens, "", "host", time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "host-tea2026-01-02_03-04-05" {
+		t.Fatalf("expected backward-compatible generated token name, got %q", name)
+	}
+}
