@@ -171,0 +196,19 @@ func runLoginAdd(requestCtx context.Context, cmd *cli.Command) error {
+
+const maximumLoginPasswordSize = 4096
+
+func readLoginPassword(reader io.Reader) (string, error) {
+	password, err := io.ReadAll(io.LimitReader(reader, maximumLoginPasswordSize+1))
+	if err != nil {
+		return "", fmt.Errorf("read password from standard input: %w", err)
+	}
+	if len(password) == 0 {
+		return "", fmt.Errorf("password from standard input is empty")
+	}
+	if len(password) > maximumLoginPasswordSize {
+		return "", fmt.Errorf("password from standard input exceeds %d bytes", maximumLoginPasswordSize)
+	}
+	if bytes.ContainsAny(password, "\x00\r\n") {
+		return "", fmt.Errorf("password from standard input must be one line")
+	}
+	return string(password), nil
+}
diff --git a/cmd/login/add_stdin_test.go b/cmd/login/add_stdin_test.go
new file mode 100644
index 0000000..ee04340
--- /dev/null
+++ b/cmd/login/add_stdin_test.go
@@ -0,0 +1,34 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package login
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestReadLoginPassword(t *testing.T) {
+	t.Run("preserves spaces", func(t *testing.T) {
+		got, err := readLoginPassword(strings.NewReader("  secret value  "))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got != "  secret value  " {
+			t.Fatalf("password changed: %q", got)
+		}
+	})
+
+	for name, value := range map[string]string{
+		"empty":   "",
+		"newline": "secret\n",
+		"nul":     "secret\x00",
+		"large":   strings.Repeat("x", maximumLoginPasswordSize+1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := readLoginPassword(strings.NewReader(value)); err == nil {
+				t.Fatal("expected password input to be rejected")
+			}
+		})
+	}
+}
