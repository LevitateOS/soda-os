{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "docker": {
      "registry.soda.local/soda/os": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/usr/share/soda/release/cosign.pub",
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    }
  }
}
