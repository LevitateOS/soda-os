<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.0"/>
  <requires lib="AnacondaWidgets" version="1.0"/>
  <object class="AnacondaSpokeWindow" id="sodaInstallationWindow">
    <property name="can_focus">False</property>
    <property name="window_name">SODA ADMINISTRATOR</property>
    <signal name="button-clicked" handler="on_back_clicked" swapped="no"/>
    <child internal-child="main_box">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child internal-child="alignment">
          <object class="GtkAlignment">
            <property name="yalign">0</property>
            <property name="xscale">1</property>
            <child internal-child="action_area">
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">Create the first Linux and Forgejo administrator and enroll this machine in your Tailnet.</property>
                    <property name="wrap">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="usernameEntry">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="placeholder_text">Administrator username</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="passwordEntry">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="visibility">False</property>
                    <property name="input_purpose">password</property>
                    <property name="placeholder_text">Administrator password</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="passwordConfirmationEntry">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="visibility">False</property>
                    <property name="input_purpose">password</property>
                    <property name="placeholder_text">Confirm administrator password</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLevelBar" id="passwordBar">
                    <property name="visible">True</property>
                    <property name="min_value">0</property>
                    <property name="max_value">4</property>
                    <property name="value">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="passwordLabel">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">Password strength</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="sshPublicKeyEntry">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="placeholder_text">ssh-ed25519 AAAA... owner@example</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="tailscaleAuthKeyEntry">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="visibility">False</property>
                    <property name="input_purpose">password</property>
                    <property name="placeholder_text">One-use Tailscale auth key</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">The Tailscale key is attempted once on first boot and then removed.</property>
                    <property name="wrap">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
