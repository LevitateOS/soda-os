#!/usr/bin/python3

import fcntl
import http.client
import json
import os
import re
import stat
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path, PurePosixPath


SYSROOT = Path("/mnt/sysroot")
RUNTIME_DIR = Path("/run/soda-installer")
USERNAME_FILE = "administrator-username"
PASSWORD_FILE = "administrator-password"
SSH_KEY_FILE = "administrator-authorized-key"
TAILSCALE_KEY_FILE = "tailscale-auth-key"
ACCOUNT_KICKSTART = "account.ks"
FORGEJO_CONFIG = "/etc/forgejo/app.ini"
FORGEJO_HOST = "127.0.0.1"
FORGEJO_PORT = 30000
TAILSCALE_KEY_PATH = "/var/lib/soda-install/tailscale-auth-key"
USERNAME_PATTERN = re.compile(r"[a-z][a-z0-9-]{0,23}")


def _open_runtime_file(name, maximum_bytes):
    path = RUNTIME_DIR / name
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
    except OSError:
        raise RuntimeError(f"required installer input {name} is unavailable") from None
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_mode & 0o077
            or metadata.st_size == 0
            or metadata.st_size > maximum_bytes
        ):
            raise RuntimeError(f"required installer input {name} is invalid")
        path.unlink()
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def _validate_runtime_directory():
    try:
        metadata = RUNTIME_DIR.lstat()
    except OSError:
        raise RuntimeError("installer runtime input state is unavailable") from None
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or RUNTIME_DIR.is_symlink()
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise RuntimeError("installer runtime input state is invalid")


def _read_descriptor(descriptor, name):
    try:
        with os.fdopen(descriptor, "rb") as stream:
            value = stream.read()
    except OSError:
        raise RuntimeError(f"required installer input {name} could not be read") from None
    if value.endswith(b"\n"):
        value = value[:-1]
    if value.endswith(b"\r"):
        value = value[:-1]
    if not value or b"\x00" in value or b"\n" in value or b"\r" in value:
        raise RuntimeError(f"required installer input {name} is not one line")
    return value


def _read_and_unlink_inputs():
    _validate_runtime_directory()
    password_fd = _open_runtime_file(PASSWORD_FILE, 4096)
    tailscale_fd = _open_runtime_file(TAILSCALE_KEY_FILE, 4096)
    username_fd = _open_runtime_file(USERNAME_FILE, 128)
    ssh_key_fd = _open_runtime_file(SSH_KEY_FILE, 16384)

    password_raw = _read_descriptor(password_fd, PASSWORD_FILE)
    tailscale_raw = _read_descriptor(tailscale_fd, TAILSCALE_KEY_FILE)
    username_raw = _read_descriptor(username_fd, USERNAME_FILE)
    ssh_key_raw = _read_descriptor(ssh_key_fd, SSH_KEY_FILE)

    account_kickstart = RUNTIME_DIR / ACCOUNT_KICKSTART
    try:
        metadata = account_kickstart.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or account_kickstart.is_symlink()
            or metadata.st_uid != 0
            or metadata.st_mode & 0o077
        ):
            raise RuntimeError("installer account Kickstart is invalid")
        account_kickstart.unlink()
        RUNTIME_DIR.rmdir()
    except OSError:
        raise RuntimeError("installer runtime input state could not be removed") from None

    try:
        username = username_raw.decode("ascii")
        password = password_raw.decode("utf-8")
        tailscale_key = tailscale_raw.decode("utf-8")
        ssh_key = ssh_key_raw.decode("utf-8")
    except UnicodeDecodeError:
        raise RuntimeError("installer input encoding is invalid") from None
    if USERNAME_PATTERN.fullmatch(username) is None:
        raise RuntimeError("the administrator username is invalid")
    if not password or not tailscale_key:
        raise RuntimeError("required installer credentials are empty")
    fields = ssh_key.split()
    if len(fields) != 2:
        raise RuntimeError("the administrator SSH public key is invalid")
    return username, password, ssh_key, tailscale_key


def _validate_persistent_target_var():
    system_root = Path(os.path.realpath(SYSROOT))
    target_var = Path(os.path.realpath(SYSROOT / "var"))
    try:
        target_var.relative_to(system_root)
    except ValueError:
        raise RuntimeError("the target variable-data root escapes the installed system") from None
    if target_var == system_root or not target_var.is_dir():
        raise RuntimeError("the target variable-data root is unavailable")

    mountpoint = str(target_var)
    try:
        records = Path("/proc/self/mountinfo").read_text(encoding="utf-8").splitlines()
    except OSError:
        raise RuntimeError("the installer mount table is unavailable") from None
    matches = []
    for record in records:
        fields = record.split()
        if len(fields) >= 6 and fields[4] == mountpoint:
            matches.append(fields)
    if len(matches) != 1 or "rw" not in matches[0][5].split(","):
        raise RuntimeError("the persistent bootc variable-data root is not mounted")


def _find_account_record(relative_path, name, minimum_fields):
    try:
        lines = (SYSROOT / relative_path).read_text(encoding="utf-8").splitlines()
    except OSError:
        raise RuntimeError("the installed Linux account database is unavailable") from None
    matches = []
    for line in lines:
        fields = line.split(":")
        if fields and fields[0] == name:
            matches.append(fields)
    if len(matches) != 1 or len(matches[0]) < minimum_fields:
        raise RuntimeError("the installed Linux account is incomplete")
    return matches[0]


def _validate_installed_linux_account(username, ssh_key):
    passwd_fields = _find_account_record("etc/passwd", username, 7)
    expected_home = PurePosixPath("/home") / username
    if PurePosixPath(passwd_fields[5]) != expected_home:
        raise RuntimeError("the installed administrator has an unexpected home")

    wheel_fields = _find_account_record("etc/group", "wheel", 4)
    wheel_members = {value for value in wheel_fields[3].split(",") if value}
    if username not in wheel_members:
        raise RuntimeError("the installed administrator is not a member of wheel")

    shadow_fields = _find_account_record("etc/shadow", username, 2)
    password_hash = shadow_fields[1]
    if not password_hash or password_hash.startswith(("!", "*")):
        raise RuntimeError("the installed administrator password is not usable")

    authorized_keys = SYSROOT / str(expected_home).lstrip("/") / ".ssh/authorized_keys"
    try:
        installed_keys = set()
        for line in authorized_keys.read_text(encoding="utf-8").splitlines():
            fields = line.split()
            if len(fields) >= 2:
                installed_keys.add(f"{fields[0]} {fields[1]}")
    except OSError:
        raise RuntimeError("the installed administrator SSH key is missing") from None
    if ssh_key not in installed_keys:
        raise RuntimeError("the installed administrator SSH key does not match")


def _bind_target_mount(source, relative_target):
    target = SYSROOT / relative_target
    target.mkdir(parents=True, exist_ok=True)
    result = subprocess.run(
        ["/usr/bin/mount", "--bind", source, str(target)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("a required target API filesystem is unavailable")
    return True


def _unmount_target(relative_target):
    result = subprocess.run(
        ["/usr/bin/umount", str(SYSROOT / relative_target)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def _target_user_command(command):
    return [
        "/usr/sbin/chroot",
        "--userspec=git:git",
        str(SYSROOT),
        "/usr/bin/env",
        "HOME=/var/lib/forgejo",
        "USER=git",
        "FORGEJO_WORK_DIR=/var/lib/forgejo",
        *command,
    ]


def _target_primary_command(username, command):
    home = f"/home/{username}"
    return [
        "/usr/sbin/chroot",
        f"--userspec={username}:{username}",
        str(SYSROOT),
        "/usr/bin/env",
        f"HOME={home}",
        f"XDG_CONFIG_HOME={home}/.config",
        f"USER={username}",
        f"LOGNAME={username}",
        "PATH=/usr/bin:/bin",
        "LANG=C.UTF-8",
        *command,
    ]


def _run_target_root(command):
    result = subprocess.run(
        ["/usr/sbin/chroot", str(SYSROOT), *command],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Forgejo initialization failed")


def _forgejo_users(admin_only):
    command = [
        "/usr/bin/forgejo",
        "admin",
        "user",
        "list",
        "--config",
        FORGEJO_CONFIG,
    ]
    if admin_only:
        command.append("--admin")
    result = subprocess.run(
        _target_user_command(command),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Forgejo user verification failed")
    users = []
    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields or not fields[0].isdigit():
            continue
        if admin_only and len(fields) >= 4:
            users.append((fields[1], fields[3].lower() == "true", True))
            continue
        if not admin_only and len(fields) >= 5:
            users.append((
                fields[1],
                fields[3].lower() == "true",
                fields[4].lower() == "true",
            ))
            continue
        raise RuntimeError("Forgejo returned an invalid user list")
    return users


def _forgejo_bootstrap_config(durable_config):
    required = {
        b"HTTP_ADDR = 127.0.0.1": 1,
        b"HTTP_PORT = 30000": 1,
        b"DISABLE_REGISTRATION = true": 1,
        b"INSTALL_LOCK = true": 1,
    }
    for setting, expected_count in required.items():
        if durable_config.count(setting) != expected_count:
            raise RuntimeError("Forgejo has an unexpected bootstrap configuration")
    return durable_config.replace(
        b"DISABLE_REGISTRATION = true",
        b"DISABLE_REGISTRATION = false",
        1,
    )


def _sealed_memfd(contents):
    descriptor = os.memfd_create(
        "soda-forgejo-bootstrap",
        os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING,
    )
    try:
        with os.fdopen(os.dup(descriptor), "wb") as stream:
            stream.write(contents)
            stream.flush()
        os.lseek(descriptor, 0, os.SEEK_SET)
        seals = (
            fcntl.F_SEAL_SEAL
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_WRITE
        )
        fcntl.fcntl(descriptor, fcntl.F_ADD_SEALS, seals)
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def _wait_for_forgejo(process):
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Forgejo exited during administrator creation")
        connection = http.client.HTTPConnection(FORGEJO_HOST, FORGEJO_PORT, timeout=1)
        try:
            connection.request("GET", "/api/healthz")
            response = connection.getresponse()
            response.read()
            if response.status == 200:
                return
        except OSError:
            pass
        finally:
            connection.close()
        time.sleep(0.2)
    raise RuntimeError("Forgejo did not become ready")


def _submit_forgejo_signup(username, password):
    form = urllib.parse.urlencode({
        "user_name": username,
        "email": f"{username}@localhost",
        "password": password,
        "retype": password,
    }).encode("utf-8")
    connection = http.client.HTTPConnection(FORGEJO_HOST, FORGEJO_PORT, timeout=10)
    try:
        try:
            connection.request(
                "POST",
                "/user/sign_up",
                body=form,
                headers={
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Content-Length": str(len(form)),
                    "Sec-Fetch-Site": "same-origin",
                },
            )
            response = connection.getresponse()
            status = response.status
            location = response.getheader("Location", "")
            response.read()
        except Exception:
            raise RuntimeError("Forgejo rejected administrator creation") from None
    finally:
        connection.close()
    if status != 303 or location != "/":
        raise RuntimeError("Forgejo rejected administrator creation")


def _configure_tea_administrator(username, password):
    login = subprocess.run(
        _target_primary_command(username, [
            "/usr/bin/tea",
            "logins",
            "add",
            "--name",
            "soda",
            "--url",
            f"http://{FORGEJO_HOST}:{FORGEJO_PORT}",
            "--user",
            username,
            "--password-stdin",
            "--token-name",
            "soda-os-tea",
            "--scopes",
            "read:user,write:repository,write:issue",
        ]),
        input=password,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if login.returncode != 0:
        raise RuntimeError("Tea could not create the administrator Forgejo login")

    identity = subprocess.run(
        _target_primary_command(username, [
            "/usr/bin/tea", "api", "--login", "soda", "user",
        ]),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    try:
        login_name = json.loads(identity.stdout)["login"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        login_name = ""
    if identity.returncode != 0 or login_name != username:
        raise RuntimeError("Tea did not verify the administrator Forgejo identity")

    config_path = SYSROOT / f"home/{username}/.config/tea/config.yml"
    try:
        metadata = config_path.lstat()
        account = _find_account_record("etc/passwd", username, 7)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or config_path.is_symlink()
            or metadata.st_uid != int(account[2])
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise RuntimeError("Tea administrator configuration is invalid")
    except OSError:
        raise RuntimeError("Tea administrator configuration is unavailable") from None


def _stop_process(process):
    if process is None or process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)


def _create_forgejo_administrator(username, password):
    mounted_dev = False
    mounted_proc = False
    config_fd = None
    process = None
    try:
        mounted_dev = _bind_target_mount("/dev", "dev")
        mounted_proc = _bind_target_mount("/proc", "proc")
        _run_target_root(["/usr/bin/systemd-tmpfiles", "--create", "forgejo.conf"])
        _run_target_root(["/usr/libexec/soda/forgejo-init"])
        if _forgejo_users(admin_only=False):
            raise RuntimeError("Forgejo already contains a user")

        config_path = SYSROOT / FORGEJO_CONFIG.lstrip("/")
        try:
            durable_config = config_path.read_bytes()
        except OSError:
            raise RuntimeError("Forgejo configuration was not initialized") from None
        config_fd = _sealed_memfd(_forgejo_bootstrap_config(durable_config))
        process = subprocess.Popen(
            _target_user_command([
                "/usr/bin/forgejo",
                "web",
                "--config",
                f"/proc/self/fd/{config_fd}",
            ]),
            pass_fds=(config_fd,),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
        )
        _wait_for_forgejo(process)
        _submit_forgejo_signup(username, password)

        try:
            if config_path.read_bytes() != durable_config:
                raise RuntimeError("Forgejo changed its durable bootstrap configuration")
        except OSError:
            raise RuntimeError("Forgejo durable configuration is unavailable") from None
        if _forgejo_users(admin_only=True) != [(username, True, True)]:
            raise RuntimeError("Forgejo did not create the requested site administrator")
        _configure_tea_administrator(username, password)
        _stop_process(process)
        process = None
    finally:
        cleanup_failed = False
        try:
            _stop_process(process)
        except Exception:
            cleanup_failed = True
        if config_fd is not None:
            try:
                os.close(config_fd)
            except OSError:
                cleanup_failed = True
        if mounted_proc:
            cleanup_failed = not _unmount_target("proc") or cleanup_failed
        if mounted_dev:
            cleanup_failed = not _unmount_target("dev") or cleanup_failed
        if cleanup_failed:
            raise RuntimeError("temporary Forgejo resources could not be removed")


def _write_tailscale_auth_key(tailscale_key):
    state_dir = SYSROOT / "var/lib/soda-install"
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    metadata = state_dir.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or state_dir.is_symlink()
        or metadata.st_uid != 0
        or metadata.st_gid != 0
    ):
        raise RuntimeError("the Tailscale enrollment handoff directory is invalid")
    os.chmod(state_dir, 0o700)
    destination = SYSROOT / TAILSCALE_KEY_PATH.lstrip("/")
    temporary = state_dir / ".tailscale-auth-key.tmp"
    if os.path.lexists(destination) or os.path.lexists(temporary):
        raise RuntimeError("the Tailscale enrollment handoff already exists")
    published = False
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(tailscale_key.encode("utf-8") + b"\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        published = True
        directory = os.open(state_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        if published:
            try:
                destination.unlink()
            except FileNotFoundError:
                pass
        raise


def _enable_tailscale_enrollment():
    command = ["/usr/bin/systemctl", "--root", str(SYSROOT), "enable", "soda-tailscale-enroll.service"]
    completed = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=False)
    if completed.returncode != 0:
        raise RuntimeError("the Tailscale enrollment service could not be enabled")


def _run():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise RuntimeError("soda-installer-finalize accepts no arguments and must run as root")
    if not SYSROOT.is_dir() or not RUNTIME_DIR.is_dir():
        raise RuntimeError("the installed system or installer input is unavailable")

    username = ""
    password = ""
    ssh_key = ""
    tailscale_key = ""
    try:
        username, password, ssh_key, tailscale_key = _read_and_unlink_inputs()
        _validate_persistent_target_var()
        _validate_installed_linux_account(username, ssh_key)
        _create_forgejo_administrator(username, password)
        password = ""

        _write_tailscale_auth_key(tailscale_key)
        try:
            _enable_tailscale_enrollment()
        except Exception:
            (SYSROOT / TAILSCALE_KEY_PATH.lstrip("/")).unlink(missing_ok=True)
            raise
    finally:
        password = ""
        tailscale_key = ""


def main():
    try:
        _run()
    except Exception as error:
        print(f"soda-installer-finalize: {error}", file=sys.stderr)
        return 1
    print("Soda installation provisioning completed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
