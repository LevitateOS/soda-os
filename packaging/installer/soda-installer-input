#!/usr/bin/python3

import os
import re
import stat
import subprocess
import sys
import time
from pathlib import Path


DEVICE_LINK = Path("/dev/disk/by-label/OEMDRV")
MOUNT_POINT = Path("/run/soda-installer-oemdrv")
MEDIA_INPUT_DIR = MOUNT_POINT / "soda"
RUNTIME_DIR = Path("/run/soda-installer")
USERNAME_FILE = "administrator-username"
PASSWORD_FILE = "administrator-password"
SSH_KEY_FILE = "administrator-authorized-key"
TAILSCALE_KEY_FILE = "tailscale-auth-key"
ACCOUNT_KICKSTART = "account.ks"
USERNAME_PATTERN = re.compile(r"[a-z][a-z0-9-]{0,23}")


def _read_media_value(name, maximum_bytes):
    path = MEDIA_INPUT_DIR / name
    try:
        metadata = path.lstat()
    except OSError:
        raise RuntimeError(f"required OEMDRV input {name} is unavailable") from None
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise RuntimeError(f"required OEMDRV input {name} is not a regular file")
    if metadata.st_size == 0 or metadata.st_size > maximum_bytes:
        raise RuntimeError(f"required OEMDRV input {name} has an invalid size")
    try:
        value = path.read_bytes()
    except OSError:
        raise RuntimeError(f"required OEMDRV input {name} could not be read") from None
    if value.endswith(b"\n"):
        value = value[:-1]
    if value.endswith(b"\r"):
        value = value[:-1]
    if not value or b"\x00" in value or b"\n" in value or b"\r" in value:
        raise RuntimeError(f"required OEMDRV input {name} is not one line")
    return value


def _validated_username(raw):
    try:
        username = raw.decode("ascii")
    except UnicodeDecodeError:
        raise RuntimeError("the administrator username is invalid") from None
    if USERNAME_PATTERN.fullmatch(username) is None:
        raise RuntimeError("the administrator username is invalid")
    return username


def _validated_password(raw):
    try:
        password = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise RuntimeError("the administrator password is invalid") from None
    if not password:
        raise RuntimeError("the administrator password is empty")
    return password


def _validated_ssh_key(raw):
    try:
        supplied = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise RuntimeError("the administrator SSH public key is invalid") from None
    fields = supplied.split()
    if len(fields) < 2:
        raise RuntimeError("the administrator SSH public key is invalid")
    key = f"{fields[0]} {fields[1]}"
    try:
        result = subprocess.run(
            ["/usr/bin/ssh-keygen", "-l", "-f", "-"],
            input=key + "\n",
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        raise RuntimeError("the administrator SSH public key could not be validated") from None
    if result.returncode != 0:
        raise RuntimeError("the administrator SSH public key is invalid")
    return key


def _validated_tailscale_key(raw):
    try:
        key = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise RuntimeError("the Tailscale auth key is invalid") from None
    if not key:
        raise RuntimeError("the Tailscale auth key is empty")
    return key


def _password_hash(password):
    try:
        result = subprocess.run(
            ["/usr/bin/openssl", "passwd", "-6", "-stdin"],
            input=password + "\n",
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        raise RuntimeError("the administrator password could not be hashed") from None
    password_hash = result.stdout.strip()
    if result.returncode != 0 or not password_hash.startswith("$6$") or any(
        character.isspace() or character == '"' for character in password_hash
    ):
        raise RuntimeError("the administrator password could not be hashed")
    return password_hash


def _write_runtime_file(name, contents):
    path = RUNTIME_DIR / name
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
    except Exception:
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        raise


def _materialize_inputs():
    username_raw = _read_media_value(USERNAME_FILE, 128)
    password_raw = _read_media_value(PASSWORD_FILE, 4096)
    ssh_key_raw = _read_media_value(SSH_KEY_FILE, 16384)
    tailscale_key_raw = _read_media_value(TAILSCALE_KEY_FILE, 4096)

    username = _validated_username(username_raw)
    password = _validated_password(password_raw)
    ssh_key = _validated_ssh_key(ssh_key_raw)
    tailscale_key = _validated_tailscale_key(tailscale_key_raw)
    password_hash = _password_hash(password)

    RUNTIME_DIR.mkdir(mode=0o700)
    _write_runtime_file(USERNAME_FILE, username.encode("ascii") + b"\n")
    _write_runtime_file(PASSWORD_FILE, password.encode("utf-8") + b"\n")
    _write_runtime_file(SSH_KEY_FILE, ssh_key.encode("utf-8") + b"\n")
    _write_runtime_file(TAILSCALE_KEY_FILE, tailscale_key.encode("utf-8") + b"\n")
    account = (
        f'user --name={username} --groups=wheel --password="{password_hash}" --iscrypted\n'
        f'sshkey --username={username} "{ssh_key}"\n'
    )
    _write_runtime_file(ACCOUNT_KICKSTART, account.encode("utf-8"))


def _remove_runtime_inputs():
    if not RUNTIME_DIR.exists():
        return
    for name in (
        USERNAME_FILE,
        PASSWORD_FILE,
        SSH_KEY_FILE,
        TAILSCALE_KEY_FILE,
        ACCOUNT_KICKSTART,
    ):
        try:
            (RUNTIME_DIR / name).unlink()
        except FileNotFoundError:
            pass
    try:
        RUNTIME_DIR.rmdir()
    except OSError:
        pass


def _eject_and_wait(device):
    result = subprocess.run(
        ["/usr/bin/eject", str(device)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0 and DEVICE_LINK.exists():
        raise RuntimeError("the parsed OEMDRV installer input could not be ejected")
    for _ in range(120):
        if not DEVICE_LINK.exists():
            return
        time.sleep(1)
    raise RuntimeError("the parsed OEMDRV installer input was not removed after ejection")


def _run():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise RuntimeError("soda-installer-input accepts no arguments and must run as root")
    if RUNTIME_DIR.exists() or MOUNT_POINT.exists():
        raise RuntimeError("Soda installer input state already exists")
    try:
        device = DEVICE_LINK.resolve(strict=True)
        if not stat.S_ISBLK(device.stat().st_mode):
            raise RuntimeError("OEMDRV is not a block device")
    except OSError:
        raise RuntimeError("OEMDRV is unavailable") from None

    mounted = False
    prepared = False
    MOUNT_POINT.mkdir(mode=0o700)
    try:
        result = subprocess.run(
            [
                "/usr/bin/mount",
                "-o",
                "ro,nodev,nosuid,noexec",
                str(device),
                str(MOUNT_POINT),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode != 0:
            raise RuntimeError("OEMDRV could not be mounted read-only")
        mounted = True
        _materialize_inputs()
        prepared = True
    finally:
        if mounted:
            result = subprocess.run(
                ["/usr/bin/umount", str(MOUNT_POINT)],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if result.returncode != 0:
                prepared = False
        try:
            MOUNT_POINT.rmdir()
        except OSError:
            prepared = False
        try:
            _eject_and_wait(device)
        except Exception:
            prepared = False
        if not prepared:
            _remove_runtime_inputs()
    if not prepared:
        raise RuntimeError("OEMDRV input preparation did not complete")


def main():
    try:
        _run()
    except Exception as error:
        print(f"soda-installer-input: {error}", file=sys.stderr)
        return 1
    print("Soda installer input prepared")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
