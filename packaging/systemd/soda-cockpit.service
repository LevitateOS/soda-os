[Unit]
Description=Soda OS development cockpit
After=network-online.target sodad.service soda-authd.service
Wants=network-online.target sodad.service soda-authd.service

[Service]
Type=simple
User=soda-cockpit
Group=soda-api
ExecStart=/usr/libexec/soda/soda-cockpit
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=soda/certs
StateDirectoryMode=0750
StandardOutput=append:/var/log/soda/soda-cockpit/service.log
StandardError=append:/var/log/soda/soda-cockpit/service.log
ReadWritePaths=/var/lib/soda/certs /var/log/soda/soda-cockpit
UMask=0027

[Install]
WantedBy=multi-user.target
