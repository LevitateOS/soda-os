[Unit]
Description=Soda OS development cockpit
After=network-online.target sodad.service
Wants=network-online.target sodad.service

[Service]
Type=simple
User=soda-cockpit
Group=soda-api
ExecStart=/usr/libexec/soda/soda-cockpit
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=soda/certs
StateDirectoryMode=0750
ReadWritePaths=/var/lib/soda/certs
UMask=0027

[Install]
WantedBy=multi-user.target
